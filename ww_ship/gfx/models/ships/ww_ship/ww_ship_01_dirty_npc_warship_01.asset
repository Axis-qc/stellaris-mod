# =============================================
# 实体定义：肮脏NPC战舰容器（带特效）
# =============================================
entity = {
    # 开始定义一个新实体
    name = "ww_ship_npf_01_dirty_npc_warship_01_entity"  # 实体在游戏中的唯一标识符
    pdxmesh = "locator_mesh"  # 使用定位器网格（通常不可见，仅用于定位）

    # 定位器定义：用于确定子部件和特效的位置
    locator = {
        # 开始定位器定义
        name = "part1"  # 定位器名称（主部件附着点）
        position = { 0 0 0 }  # 定位器在模型空间中的位置坐标 (x,y,z)
    }  # 定位器定义结束

    # 第二个定位器：用于爆炸特效
    locator = {
        # 开始定位器定义
        name = "explosion"  # 定位器名称（爆炸特效点）
        position = { 0 -15 -50 }  # 定位器位置（在战舰下方偏后）
    }  # 定位器定义结束

    cull_radius = 10.0  # 剔除半径：当相机距离超过此值（单位：游戏单位）时，该实体不会被渲染

    # 动画状态设置
    default_state = "idle"  # 默认动画状态名称

    # 空闲状态定义
    state = {
        # 开始定义动画状态
        name = "idle"  # 状态名称（空闲）
        state_time = 5  # 状态持续时间（秒），之后可能过渡到其他状态
    }  # 动画状态定义结束

    # 移动状态定义
    state = {
        # 开始定义动画状态
        name = "moving"  # 状态名称（移动）
        state_time = 5  # 状态持续时间（秒）
    }  # 动画状态定义结束

    # 死亡状态定义（带特效）
    state = {
        # 开始定义动画状态
        name = "death"  # 状态名称（死亡）
        state_time = 8.9  # 状态总持续时间（秒）
        looping = no  # 不循环播放（只播放一次）

        # 爆炸特效事件（在状态时间8.8秒时触发）
        event = {
            # 开始事件定义
            time = 8.8  # 事件触发时间（秒）
            node = "explosion"  # 触发特效的节点名称
            particle = "dreadnought_explosion_particle"  # 使用的粒子特效资源
            keep_particle = yes  # 特效持续存在（不自动消失）
        }  # 事件定义结束
    }  # 动画状态定义结束
}  # 实体定义结束

# =============================================
# 实体定义：肮脏NPC战舰船体（带详细特效）
# =============================================
entity = {
    # 开始定义一个新实体
    name = "ww_ship_npf_01_dirty_npc_warship_01_hull_entity"  # 实体在游戏中的唯一标识符
    pdxmesh = "ww_ship_npf_01_dirty_npc_warship_01_mesh"  # 指定使用的3D网格资源文件（肮脏船体）

