        # 开始事件（播放音效）
        start_event = {
            # 开始事件定义
            trigger_once = yes  # 只触发一次
            sound = {
                # 声音效果
                soundeffect = "dreadnaught_idle"  # 使用的音效资源
            }  # 声音效果结束
        }  # 事件定义结束

