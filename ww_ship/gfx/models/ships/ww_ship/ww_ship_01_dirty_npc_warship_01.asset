# =============================================
# 实体定义：肮脏NPC战舰完整版（带炮塔）
# =============================================
entity = {
    # 开始定义一个新实体
    name = "ww_ship_npf_01_dirty_npc_warship_01_hull_entity2"  # 实体在游戏中的唯一标识符

    # 注释掉的备用网格（当前未使用）
    #pdxmesh = "stellarite_mesh"

    pdxmesh = "ww_ship_npf_01_dirty_npc_warship_01_mesh"  # 指定使用的3D网格资源文件（同基础船体）

    # 动画状态设置
    default_state = "idle"  # 默认动画状态名称
    state = {
        # 开始定义动画状态
        name = "idle"  # 状态名称（空闲）
        animation = "idle"  # 对应的动画资源
    }  # 动画状态定义结束

