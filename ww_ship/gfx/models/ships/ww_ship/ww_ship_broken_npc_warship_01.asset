    attach = { small_gun_03 = "npf_01_broken_turret_small_entity" }  # 在small_gun_03位置附着小型炮塔实体

    # 左右对称的小型炮塔附着点
    attach = { small_gun_04_l = "npf_01_broken_turret_small_entity" }  # 左侧小型炮塔
    attach = { small_gun_04_r = "npf_01_broken_turret_small_entity" }  # 右侧小型炮塔
    attach = { small_gun_05_l = "npf_01_broken_turret_small_entity" }  # 左侧小型炮塔
    attach = { small_gun_05_r = "npf_01_broken_turret_small_entity" }  # 右侧小型炮塔

    # 左右对称的大型炮塔附着点
    attach = { large_gun_03_l = "npf_01_broken_large_turret_entity" }  # 左侧大型炮塔
    attach = { large_gun_03_r = "npf_01_broken_large_turret_entity" }  # 右侧大型炮塔
    attach = { large_gun_04_l = "npf_01_broken_large_turret_entity" }  # 左侧大型炮塔
    attach = { large_gun_04_r = "npf_01_broken_large_turret_entity" }  # 右侧大型炮塔
    attach = { large_gun_05_l = "npf_01_broken_large_turret_entity" }  # 左侧大型炮塔
    attach = { large_gun_05_r = "npf_01_broken_large_turret_entity" }  # 右侧大型炮塔
    attach = { large_gun_06_l = "npf_01_broken_large_turret_entity" }  # 左侧大型炮塔
    attach = { large_gun_06_r = "npf_01_broken_large_turret_entity" }  # 右侧大型炮塔

    # 其他炮塔附着点
    attach = { large_gun_07 = "npf_01_broken_large_turret_entity" }  # 单一大大型炮塔
    attach = { small_gun_08 = "npf_01_broken_turret_small_entity" }  # 单个小型炮塔
    attach = { small_gun_09 = "npf_01_broken_turret_small_entity" }  # 单个小型炮塔
    attach = { small_gun_10 = "npf_01_broken_turret_small_entity" }  # 单个小型炮塔


    scale = 2  # 模型缩放比例（2.5表示放大到原始大小的250%）
