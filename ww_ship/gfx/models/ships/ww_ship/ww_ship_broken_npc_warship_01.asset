    state = {
        # 开始定义动画状态
        name = "idle"  # 状态名称
        animation = "idle"  # 该状态对应的动画资源标识
    }  # 动画状态定义结束

    # 以下是注释掉的炮塔附着点配置（当前未激活）

    # 大型炮塔附着点配置（每个attach定义一组附着关系）
    attach = { large_gun_01 = "npf_01_broken_large_turret_entity" }  # 在large_gun_01位置附着大型炮塔实体
    attach = { large_gun_02 = "npf_01_broken_large_turret_entity" }  # 在large_gun_02位置附着大型炮塔实体

    # 小型炮塔附着点配置
