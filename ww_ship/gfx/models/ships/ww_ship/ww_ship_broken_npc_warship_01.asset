# =============================================
# 实体定义：NPC战舰残骸容器
# =============================================
entity = {
    # 开始定义一个新实体
    name = "ww_ship_npf_01_broken_npc_warship_01_entity"  # 实体在游戏中的唯一标识符

    # 定位器定义：用于确定子部件的位置
    locator = {
        # 开始定位器定义
        name = "part1"  # 定位器名称（用于子部件附着点）
        position = { 0 0 0 }  # 定位器在模型空间中的位置坐标 (x,y,z)
    }  # 定位器定义结束

    cull_radius = 10.0  # 剔除半径：当相机距离超过此值（单位：游戏单位）时，该实体不会被渲染
}  # 实体定义结束

# =============================================
# 实体定义：NPC战舰船体残骸（基础版本）
# =============================================
entity = {
    # 开始定义一个新实体
    name = "ww_ship_npf_01_broken_npc_warship_01_hull_entity"  # 实体在游戏中的唯一标识符
    pdxmesh = "ww_ship_npf_01_broken_npc_warship_01_mesh"  # 指定使用的3D网格资源文件

    scale = 2  # 模型缩放比例

    # 动画状态设置
    default_state = "idle"  # 默认动画状态名称
    state = {
        # 开始定义动画状态
        name = "idle"  # 状态名称
        animation = "idle"  # 该状态对应的动画资源标识
    }  # 动画状态定义结束
}  # 实体定义结束

