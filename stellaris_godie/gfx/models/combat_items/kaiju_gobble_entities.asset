# 噬天巨兽吞噬星球：星球侧粒子载体实体
#
# 由脚本当环境物体用（br_kaiju_gobble_windup_vfx，br.6001 生成在星球位置，
# play_animation_once = no 循环播）；写法照抄原版 colossus_shatter_planet_hit_entity
# （纯粒子载体：只有 cull_radius，没有网格/locator）。state_time = 25。

entity = {
	name = "kaiju_gobble_planet_hit_entity"
	cull_radius = 1.0

	default_state = "idle"
	state = { name = "idle" state_time = 25 looping = no
		start_event = { particle = "kaiju_gobble_planet_effect" keep_particle = yes }
	}
	state = { name = "stop" state_time = 0.5 looping = no }
}
