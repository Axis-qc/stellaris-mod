# 利维坦·泰扬基母兽 独立 pdxmesh（不覆盖原版 leviathan_01_elder_tiyanki_mesh）
# meshsettings 逐字照抄原版 leviathan_01_elder_tiyanki.gfx 主段
# 动画行全部换成 lev_tiyanki_* 注册名（注册见同目录 lev_tiyanki.asset）

objectTypes = {
	pdxmesh = {
		name = "lev_tiyanki_mesh"
		file = "gfx/models/ships/guardians/elder_tiyanki/leviathan_01_elder_tiyanki.mesh"

		animation = { id = "idle"						type = "lev_tiyanki_idle_animation" }
		animation = { id = "moving"						type = "lev_tiyanki_moving_animation" }
		animation = { id = "combat_transition_idle"		type = "lev_tiyanki_combat_transition_idle_animation" }
		animation = { id = "combat_idle"				type = "lev_tiyanki_combat_idle_animation" }
		animation = { id = "combat_moving"				type = "lev_tiyanki_combat_moving_animation" }
		animation = { id = "combat_transition_moving"	type = "lev_tiyanki_combat_transition_moving_animation" }
		animation = { id = "combat_death"				type = "lev_tiyanki_combat_death_animation" }
		animation = { id = "death"						type = "lev_tiyanki_death_animation" }

		meshsettings = {
			name = "polySurface1Shape"
			index = 0
			texture_diffuse = "elder_tiyanki_01_diffuse.dds"
			texture_normal = "elder_tiyanki_01_normal.dds"
			texture_specular = "elder_tiyanki_01_specular.dds"
			shader = "PdxMeshShip"
		}
	}
}
