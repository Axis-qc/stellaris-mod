# 利维坦·天龙 实体与动画（mod 独立定义，全用 lev_aquatic_* 前缀，不覆盖原版）
# section entity 从原版 aquatic_dragon_section_entity 镜像：attach floater、状态集、scale、game_data 照抄，音效省略
# floater 副实体从原版 aquatic_dragon_01_floater_1/2_entity 镜像（含各自 UV 动画参数）
# 注意：.anim 按声明处目录解析，引用的原版动画已全部复制进本目录

# ── floater 副实体（身体流光，attach 到 part1）──
entity = {
	name = "lev_aquatic_floater_1_entity"
	## Body
	pdxmesh = "lev_aquatic_floater_1_mesh"

	game_data = {
		bloom_factor = 1
		uv_animation_speed = 0.035
		uv_animation_direction = { -0.1 0.55 }
	}

	scale = 1

	default_state = "idle"
	state = { name = "idle" animation = "idle" animation_blend_time = 1.5
	}
	state = { name = "moving" animation = "moving" animation_blend_time = 1
	}
	state = { name = "death" animation = "death" looping = no
	}

	state = { name = "combat_moving" animation = "moving" animation_blend_time = 0
	}

	state = { name = "attack" animation = "attack" looping = no animation_blend_time = 1 next_state = "idle"
	}
}

entity = {
	name = "lev_aquatic_floater_2_entity"
	## Wings
	pdxmesh = "lev_aquatic_floater_2_mesh"

	game_data = {
		bloom_factor = 0.3
		uv_animation_speed = 0.03
		uv_animation_direction = { -0.1 0.55 }
	}
	scale = 1

	default_state = "idle"
	state = { name = "idle" animation = "idle" animation_blend_time = 1.5
	}
	state = { name = "moving" animation = "moving" animation_blend_time = 1
	}
	state = { name = "death" animation = "death" looping = no
	}

	state = { name = "combat_moving" animation = "moving" animation_blend_time = 0
	}

	state = { name = "attack" animation = "attack" looping = no animation_blend_time = 1 next_state = "idle"
	}
}

# ── section entity（镜像原版 aquatic_dragon_section_entity）──
entity = {
	name = "lev_aquatic_section_entity"
	pdxmesh = "lev_aquatic_mesh"
	scale = 1.0
	cull_radius = 100.0

	attach = { part1 = "lev_aquatic_floater_1_entity" }
	attach = { part1 = "lev_aquatic_floater_2_entity" }

	locator = { name = "part1" 	position = { 0 0 0 } }
	locator = { name = "wing_1_3" 	position = { 0 0 0 } }
	locator = { name = "wing_2_3" 	position = { 0 0 0 } }
	locator = { name = "wing_3_4" 	position = { 0 0 0 } }
	locator = { name = "wing_4_3" 	position = { 0 0 0 } }

	default_state = "idle"
	state = { name = "idle" animation = "idle" animation_blend_time = 1.5
	}
	state = { name = "moving" animation = "moving" animation_blend_time = 1
	}
	state = { name = "death" animation = "death" looping = no
	}

	state = { name = "combat_moving" animation = "moving" animation_blend_time = 0
	}

	state = { name = "attack" animation = "attack" looping = no animation_blend_time = 1 next_state = "idle"
	}

	game_data = { size = 50 }
}

# ── 舰船 entity（镜像原版 aquatic_dragon_entity）──
entity = {
	name = "lev_aquatic_entity"
	pdxmesh = "locator_mesh"

	locator = { name = "part1" 	position = { 0 0 0 } }
	locator = { name = "wing_1_3" 	position = { 0 0 0 } }
	locator = { name = "wing_2_3" 	position = { 0 0 0 } }
	locator = { name = "wing_3_4" 	position = { 0 0 0 } }
	locator = { name = "wing_4_3" 	position = { 0 0 0 } }

	cull_radius = 100.0
	game_data = {
		raytrace_projectiles = no
		dissolve_on_death = 8.0
		ship_color = hsv { 0.6 1.0 0.75 1.0 }
	}
}

# ── 动画注册（file 写裸文件名，按声明处目录解析为本目录）──
animation = {
	name = "lev_aquatic_idle_animation"
	file = "aquatic_dragon_01_idle.anim"
}

animation = {
	name = "lev_aquatic_moving_animation"
	file = "aquatic_dragon_01_moving.anim"
}

animation = {
	name = "lev_aquatic_death_animation"
	file = "aquatic_dragon_01_death.anim"
}

animation = {
	name = "lev_aquatic_attack_animation"
	file = "aquatic_dragon_01_attack.anim"
}

animation = {
	name = "lev_aquatic_floater_1_idle_animation"
	file = "aquatic_dragon_floater_01_idle.anim"
}

animation = {
	name = "lev_aquatic_floater_1_moving_animation"
	file = "aquatic_dragon_floater_01_moving.anim"
}

animation = {
	name = "lev_aquatic_floater_1_death_animation"
	file = "aquatic_dragon_floater_01_death.anim"
}

animation = {
	name = "lev_aquatic_floater_1_attack_animation"
	file = "aquatic_dragon_floater_01_attack.anim"
}

animation = {
	name = "lev_aquatic_floater_2_idle_animation"
	file = "aquatic_dragon_floater_03_idle.anim"
}

animation = {
	name = "lev_aquatic_floater_2_moving_animation"
	file = "aquatic_dragon_floater_03_moving.anim"
}

animation = {
	name = "lev_aquatic_floater_2_death_animation"
	file = "aquatic_dragon_floater_03_death.anim"
}

animation = {
	name = "lev_aquatic_floater_2_attack_animation"
	file = "aquatic_dragon_floater_03_attack.anim"
}
