# 利维坦·毒神 实体（mod 独立定义，全用 lev_toxic_god_* 前缀，不覆盖原版）
# 动画注册走噬星者模式：本文件末尾自建 lev_toxic_god_*_animation，file 暂指原版 .anim 文件
# attach 原版 toxic_god_debris_entity 保留碎壳层
# section entity 状态集从原版 toxic_god_section_entity 镜像（idle/moving 双分支 chance、working/open、death 双分支、attack、combat_moving）
# 粒子 event（back_scale_01~04 的毒雾副实体）照抄原版，音效 event 省略

entity = {
	name = "lev_toxic_god_section_entity"
	pdxmesh = "lev_toxic_god_mesh"
	cull_radius = 100.0

	attach = { "root" = "toxic_god_debris_entity" }

	default_state = "idle"
	# 常规 idle：从 idle/moving 进入
	state = { name = "idle" animation = "idle" looping = yes next_state = "idle" animation_blend_time = 4
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"death" = 0
				"working" = 100
				"working_looping" = 0
			}
		}
	}
	# 从开壳状态回 idle：播闭壳
	state = { name = "idle" animation = "closing" animation_speed = 2 looping = no next_state = "idle"
		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"death" = 0
				"working" = 100
				"working_looping" = 100
			}
		}
	}
	# 常规 moving
	state = { name = "moving" animation = "moving" looping = yes next_state = "moving" animation_blend_time = 1
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"death" = 0
				"working" = 100
				"working_looping" = 0
			}
		}
	}
	# 从开壳状态转移动：播闭壳
	state = { name = "moving" animation = "closing" animation_speed = 2 looping = no next_state = "moving"
		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"death" = 0
				"working" = 0
				"working_looping" = 100
			}
		}
	}
	# 开壳持续状态（原版 kill_planet 流程的 working_looping）
	state = { name = "working_looping" animation = "open"
		event = { time = 0	id = "beam_start" }
		event = { time = 0.5 node = "back_scale_01" entity = "toxic_god_effect_entity" erosion_in = 0.8			erosion_out = 1 trigger_once = yes}
		event = { time = 1 node = "back_scale_02" entity = "toxic_god_effect_entity" erosion_in = 0.8			erosion_out = 1 trigger_once = yes}
		event = { time = 1.5 node = "back_scale_03" entity = "toxic_god_effect_entity" erosion_in = 0.8			erosion_out = 1 trigger_once = yes}
		event = { time = 2 node = "back_scale_04" entity = "toxic_god_effect_entity" erosion_in = 0.8			erosion_out = 1 trigger_once = yes}
	}
	# 开壳过程
	state = { name = "working" animation = "opening" looping = no next_state = "working_looping"
		event = { time = 250 id = "beam_start" }
	}
	# 闭壳死亡
	state = { name = "death" animation = "closed_death" looping = no
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"death" = 0
				"working" = 0
				"working_looping" = 0
			}
		}
	}
	# 开壳死亡
	state = { name = "death" animation = "opened_death" looping = no animation_blend_time = 2
		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"death" = 0
				"working" = 100
				"working_looping" = 100
			}
		}
	}
	# 攻击
	state = { name = "attack" animation = "attack" looping = no animation_blend_time = 1 next_state = "idle"
		event = { time = 0.5 node = "back_scale_01" entity = "toxic_god_effect_entity" erosion_in = 0.8			erosion_out = 1 trigger_once = yes}
		event = { time = 1 node = "back_scale_02" entity = "toxic_god_effect_entity" erosion_in = 0.8			erosion_out = 1 trigger_once = yes}
		event = { time = 1.5 node = "back_scale_03" entity = "toxic_god_effect_entity" erosion_in = 0.8			erosion_out = 1 trigger_once = yes}
		event = { time = 2 node = "back_scale_04" entity = "toxic_god_effect_entity" erosion_in = 0.8			erosion_out = 1 trigger_once = yes}
	}
	# 战斗移动
	state = { name = "combat_moving" animation = "moving" animation_blend_time = 1}
}

entity = {
	name = "lev_toxic_god_entity"
	pdxmesh = "locator_mesh"
	cull_radius = 100.0

	default_state = "idle"
	state = { name = "idle" state_time = 6 looping = no}
	state = { name = "moving" state_time = 6 looping = no}
	state = { name = "working" state_time = 6 looping = no}
	state = { name = "death" state_time = 14 looping = no
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"death" = 0
				"working" = 0
			}
		}
	}
	state = { name = "death" state_time = 14 looping = no
		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"death" = 0
				"working" = 100
			}
		}
	}

	game_data = {
		raytrace_projectiles = no
		dissolve_on_death = 7.0
		ship_color = hsv { 0.27 0.80 0.60 1.0 }
	}

	locator = { name = "part1" 	position = { 0 0 0 } }
}

animation = {
	name = "lev_toxic_god_idle_animation"
	file = "toxic_god_idle.anim"
}

animation = {
	name = "lev_toxic_god_moving_animation"
	file = "toxic_god_moving.anim"
}

animation = {
	name = "lev_toxic_god_opening_animation"
	file = "toxic_god_opening.anim"
}

animation = {
	name = "lev_toxic_god_open_animation"
	file = "toxic_god_open.anim"
}

animation = {
	name = "lev_toxic_god_closing_animation"
	file = "toxic_god_closing.anim"
}

animation = {
	name = "lev_toxic_god_attack_animation"
	file = "toxic_god_attack.anim"
}

animation = {
	name = "lev_toxic_god_death_animation"
	file = "toxic_god_death.anim"
}
