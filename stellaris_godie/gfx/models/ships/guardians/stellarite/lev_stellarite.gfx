# 利维坦·噬星者 —— 独立 pdxmesh（lev_stellarite_mesh），不覆盖原版 stellarite_mesh
# 动画链路：entity state 的 animation 值 -> 此处 id -> type -> lev_stellarite.asset 的注册

objectTypes = {
	pdxmesh = {
		name = "lev_stellarite_mesh"
		file = "gfx/models/ships/guardians/stellarite/stellarite.mesh"
		scale = 1.0
		
		animation = { id = "idle"		type = "lev_stellarite_idle_animation" }
		animation = { id = "moving"		type = "lev_stellarite_moving_animation" }
		animation = { id = "death"		type = "lev_stellarite_death_animation" }
		animation = { id = "attack"		type = "lev_stellarite_attack_animation" }
		animation = { id = "breath_begin"	type = "lev_stellarite_breath_begin_animation" }
		animation = { id = "breath_loop"	type = "lev_stellarite_breath_loop_animation" }
		animation = { id = "breath_end"	type = "lev_stellarite_breath_end_animation" }
		# beam_fire：恒星光束喷射状态的动画别名（状态复用 breath_loop 动画，注册别名以通过校验）
		animation = { id = "beam_fire"	type = "lev_stellarite_breath_loop_animation" }

		meshsettings = {
			name = "MembraneShape"
			index = 0
			texture_diffuse = "stellarite_membrane_diffuse.dds"
			texture_normal = "stellarite_normal.dds"
			texture_specular = "stellarite_specular.dds"
			shader = "PdxMeshExtraDimensionalShip"
		}

		meshsettings = {
			name = "BodyShape"
			index = 0
			texture_diffuse = "stellarite_diffuse.dds"
			texture_normal = "stellarite_normal.dds"
			texture_specular = "stellarite_specular.dds"
			shader = "PdxMeshExtraDimensionalShip"
		}
	}
}
