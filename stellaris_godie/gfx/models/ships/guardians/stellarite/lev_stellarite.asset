# 利维坦·噬星者 实体与动画（mod 独立定义，全用 lev_stellarite_* 前缀，不覆盖原版）

entity = {
	name = "lev_stellarite_section_entity"
	pdxmesh = "lev_stellarite_mesh"
	cull_radius = 100.0

	default_state = "idle"
	state = { name = "idle" animation = "idle" animation_blend_time = 1
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"combat_moving" = 100
				"death" = 0
				"working" = 100
				"working_looping" = 0
				"absorb_active" = 0
			}
		}
		event = { time = 0 node = "body_locator" particle = "stellarite_body_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "core_location" particle = "stellarite_core_effect" keep_particle = yes trigger_once = yes }
		event = { trigger_once = yes sound = { soundeffect = "stellarites_idle_breath" stop_on_state_change = yes } }
		event = { trigger_once = yes sound = { soundeffect = "distance_stellarites_idle_breath" stop_on_state_change = yes } }
		start_event = { trigger_once = yes sound = { soundeffect = "stellarites_idle_drone" } }
	}
	# 从吸食状态回 idle 时播结束段（chance 里 working_looping = 100 才选到）
	state = { name = "idle" animation = "absorb_end" animation_blend_time = 0.5 looping = no next_state = "idle"
		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"combat_moving" = 0
				"death" = 0
				"working" = 0
				"working_looping" = 100
				"absorb_active" = 100
			}
		}
		event = { time = 0 node = "body_locator" particle = "stellarite_body_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "core_location" particle = "stellarite_core_effect" keep_particle = yes trigger_once = yes }
		event = { trigger_once = yes sound = { soundeffect = "stellarites_idle_breath" stop_on_state_change = yes } }
		event = { trigger_once = yes sound = { soundeffect = "distance_stellarites_idle_breath" stop_on_state_change = yes } }
	}
	state = { name = "moving" animation = "idle" animation_blend_time = 1
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"combat_moving" = 100
				"death" = 0
				"working" = 100
				"working_looping" = 0
				"absorb_active" = 0
			}
		}
		event = { time = 0 node = "body_locator" particle = "stellarite_body_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "core_location" particle = "stellarite_core_effect" keep_particle = yes trigger_once = yes }
		# 移动拖尾：large_gun_01~08 是八个喷口挂点，各挂一份橙金熔岩粒子
		event = { time = 0 node = "large_gun_01" particle = "lev_stellarite_move_trail_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "large_gun_02" particle = "lev_stellarite_move_trail_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "large_gun_03" particle = "lev_stellarite_move_trail_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "large_gun_04" particle = "lev_stellarite_move_trail_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "large_gun_05" particle = "lev_stellarite_move_trail_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "large_gun_06" particle = "lev_stellarite_move_trail_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "large_gun_07" particle = "lev_stellarite_move_trail_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "large_gun_08" particle = "lev_stellarite_move_trail_effect" keep_particle = yes trigger_once = yes }
		event = { trigger_once = yes sound = { soundeffect = "stellarites_idle_breath" stop_on_state_change = yes } }
		event = { trigger_once = yes sound = { soundeffect = "distance_stellarites_idle_breath" stop_on_state_change = yes } }

	}
	# 同 idle 的结束段
	state = { name = "moving" animation = "absorb_end" animation_blend_time = 0.5 looping = no next_state = "moving"
		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"combat_moving" = 0
				"death" = 0
				"working" = 0
				"working_looping" = 100
				"absorb_active" = 100
			}
		}
		event = { time = 0 node = "body_locator" particle = "stellarite_body_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "core_location" particle = "stellarite_core_effect" keep_particle = yes trigger_once = yes }
		event = { trigger_once = yes sound = { soundeffect = "stellarites_idle_breath" stop_on_state_change = yes } }
		event = { trigger_once = yes sound = { soundeffect = "distance_stellarites_idle_breath" stop_on_state_change = yes } }
	}
	state = { name = "death" animation = "death" animation_blend_time = 1 looping = no
		event = { trigger_once = yes sound = { soundeffect = "stellarites_idle_death" } }
		event = { trigger_once = yes sound = { soundeffect = "distance_stellarites_idle_death" } }
	}

	state = { name = "combat_moving" animation = "idle" animation_blend_time = 2
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"combat_moving" = 100
				"death" = 0
				"working" = 100
				"working_looping" = 0
				"absorb_active" = 0
			}
		}
		event = { time = 0 node = "body_locator" particle = "stellarite_body_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "core_location" particle = "stellarite_core_effect" keep_particle = yes trigger_once = yes }
		# 移动拖尾：large_gun_01~08 是八个喷口挂点，各挂一份橙金熔岩粒子
		event = { time = 0 node = "large_gun_01" particle = "lev_stellarite_move_trail_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "large_gun_02" particle = "lev_stellarite_move_trail_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "large_gun_03" particle = "lev_stellarite_move_trail_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "large_gun_04" particle = "lev_stellarite_move_trail_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "large_gun_05" particle = "lev_stellarite_move_trail_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "large_gun_06" particle = "lev_stellarite_move_trail_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "large_gun_07" particle = "lev_stellarite_move_trail_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "large_gun_08" particle = "lev_stellarite_move_trail_effect" keep_particle = yes trigger_once = yes }
		event = { trigger_once = yes sound = { soundeffect = "stellarites_idle_breath" stop_on_state_change = yes } }
		event = { trigger_once = yes sound = { soundeffect = "distance_stellarites_idle_breath" stop_on_state_change = yes } }

	}
	# 同 idle 的结束段
	state = { name = "combat_moving" animation = "absorb_end" animation_blend_time = 0.5 looping = no next_state = "combat_moving"
		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"combat_moving" = 0
				"death" = 0
				"working" = 0
				"working_looping" = 100
				"absorb_active" = 100
			}
		}
		event = { time = 0 node = "body_locator" particle = "stellarite_body_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "core_location" particle = "stellarite_core_effect" keep_particle = yes trigger_once = yes }
		event = { trigger_once = yes sound = { soundeffect = "stellarites_idle_breath" stop_on_state_change = yes } }
		event = { trigger_once = yes sound = { soundeffect = "distance_stellarites_idle_breath" stop_on_state_change = yes } }
	}

	state = { name = "attack" animation = "attack" animation_blend_time = 0.45 looping = no
		event = { time = 0 node = "body_locator" particle = "stellarite_body_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "core_location" particle = "stellarite_core_effect" keep_particle = yes trigger_once = yes }
		event = { trigger_once = yes sound = { soundeffect = "stellarites_idle_breath" stop_on_state_change = yes } }
		event = { trigger_once = yes sound = { soundeffect = "distance_stellarites_idle_breath" stop_on_state_change = yes } }
		start_event = { trigger_once = yes sound = { soundeffect = "stellarites_idle_drone" } }
	}

	# 吐息三段：begin 蓄力张嘴 / loop 持续张嘴 / end 闭嘴收势
	state = { name = "breath_begin" animation = "breath_begin" animation_blend_time = 0.5 looping = no }
	state = { name = "breath_loop" animation = "breath_loop" animation_blend_time = 0.5 }
	state = { name = "breath_end" animation = "breath_end" animation_blend_time = 0.5 looping = no }

	# 灭星链：working 为 idle 占位，working_looping 播 absorb_begin，absorb_active 循环至攻击结束，收尾走 idle/moving/combat_moving 的 chance 分支
	# beam_start 是引擎开火挂钩，缺它 planet_destruction_gfx 会提前放出
	state = { name = "working" animation = "idle" animation_blend_time = 0.5 looping = no state_time = 20.0 next_state = "working_looping"
		event = { time = 1000 id = "beam_start" } #will never fire, but lets the game know that an event with this ID exists
	}
	state = { name = "working_looping" animation = "absorb_begin" animation_blend_time = 0.5 looping = no next_state = "absorb_active"
		event = { time = 0 id = "beam_start" }
		event = { trigger_once = yes sound = { soundeffect = "stellarites_windup_beam" stop_on_state_change = yes } }
	}
	state = { name = "absorb_active" animation = "absorb_loop" animation_blend_time = 0.5 looping = yes
	}

	# 恒星光束：复用 breath_loop 张嘴动画，特效挂嘴部定位点 xl_gun_01
	state = { name = "beam_fire" animation = "breath_loop" animation_blend_time = 0.5 looping = no
		event = { time = 0.2 node = "xl_gun_01" particle = "stellarite_titan_muzzle_windup" trigger_once = yes }
		event = { time = 0.2 trigger_once = yes sound = { soundeffect = "stellarites_windup_beam" } }
		event = { time = 0.8 node = "xl_gun_01" particle = "stellarite_titan_muzzle_particle" trigger_once = yes }
		event = { time = 0.8 trigger_once = yes sound = { soundeffect = "stellarites_fire_beam" } }
		event = { time = 0.8 trigger_once = yes sound = { soundeffect = "distance_stellarites_fire_beam" } }
	}

	scale = 0.5

	game_data = {
		uv_animation_speed 		= 10.0
		uv_animation_direction 	= { 0.0 0.02 }
		bloom_factor = 2
	}
}

entity = {
	name = "lev_stellarite_entity"
	pdxmesh = "locator_mesh"
	cull_radius = 100.0

	locator = { name = "part1" }

	default_state = "idle"
	state = { name = "idle" state_time = 6 }
	state = { name = "moving" state_time = 6 }
	state = { name = "working" state_time = 6 }
	state = { name = "working_looping" state_time = 6 }
	state = { name = "death" state_time = 3 looping = no }

  	game_data = {
		size = 30.0
	  	raytrace_projectiles = no
  		dissolve_on_death = 3.0
		ship_color = hsv { 0.11 1.0 0.75 1.0 }
	}

	scale = 3
}

animation = {
	name = "lev_stellarite_idle_animation"
	file = "stellarite_idle.anim"
}

animation = {
	name = "lev_stellarite_moving_animation"
	file = "stellarite_moving.anim"
}

animation = {
	name = "lev_stellarite_death_animation"
	file = "stellarite_death.anim"
}

animation = {
	name = "lev_stellarite_attack_animation"
	file = "stellarite_attack.anim"
}

animation = {
	name = "lev_stellarite_breath_begin_animation"
	file = "stellarite_breath_begin.anim"
}

animation = {
	name = "lev_stellarite_breath_loop_animation"
	file = "stellarite_breath_loop.anim"
}

animation = {
	name = "lev_stellarite_breath_end_animation"
	file = "stellarite_breath_end.anim"
}

animation = {
	name = "lev_stellarite_absorb_begin_animation"
	file = "stellarite_absorb_begin.anim"
}

animation = {
	name = "lev_stellarite_absorb_loop_animation"
	file = "stellarite_absorb_loop.anim"
}

animation = {
	name = "lev_stellarite_absorb_end_animation"
	file = "stellarite_absorb_end.anim"
}
