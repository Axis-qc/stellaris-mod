# 利维坦·噬星者 实体与动画（mod 独立定义，全用 lev_stellarite_* 前缀，不覆盖原版）

entity = {
	name = "lev_stellarite_section_entity"
	pdxmesh = "lev_stellarite_mesh"

	default_state = "idle"
	state = { name = "idle" animation = "idle" animation_blend_time = 1
		event = { time = 0 node = "body_locator" particle = "stellarite_body_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "core_location" particle = "stellarite_core_effect" keep_particle = yes trigger_once = yes }
		event = { trigger_once = yes sound = { soundeffect = "stellarites_idle_breath" stop_on_state_change = yes } }
		event = { trigger_once = yes sound = { soundeffect = "distance_stellarites_idle_breath" stop_on_state_change = yes } }
		start_event = { trigger_once = yes sound = { soundeffect = "stellarites_idle_drone" } }
	}
	state = { name = "moving" animation = "idle" animation_blend_time = 1
		event = { time = 0 node = "body_locator" particle = "stellarite_body_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "core_location" particle = "stellarite_core_effect" keep_particle = yes trigger_once = yes }
		event = { trigger_once = yes sound = { soundeffect = "stellarites_idle_breath" stop_on_state_change = yes } }
		event = { trigger_once = yes sound = { soundeffect = "distance_stellarites_idle_breath" stop_on_state_change = yes } }

	}
	state = { name = "death" animation = "death" animation_blend_time = 1 looping = no
		event = { trigger_once = yes sound = { soundeffect = "stellarites_idle_death" } }
		event = { trigger_once = yes sound = { soundeffect = "distance_stellarites_idle_death" } }
	}

	state = { name = "combat_moving" animation = "idle" animation_blend_time = 2
		event = { time = 0 node = "body_locator" particle = "stellarite_body_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "core_location" particle = "stellarite_core_effect" keep_particle = yes trigger_once = yes }
		event = { trigger_once = yes sound = { soundeffect = "stellarites_idle_breath" stop_on_state_change = yes } }
		event = { trigger_once = yes sound = { soundeffect = "distance_stellarites_idle_breath" stop_on_state_change = yes } }

	}

	state = { name = "attack" animation = "attack" animation_blend_time = 0.45 looping = no
		event = { time = 0 node = "body_locator" particle = "stellarite_body_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "core_location" particle = "stellarite_core_effect" keep_particle = yes trigger_once = yes }
		event = { trigger_once = yes sound = { soundeffect = "stellarites_idle_breath" stop_on_state_change = yes } }
		event = { trigger_once = yes sound = { soundeffect = "distance_stellarites_idle_breath" stop_on_state_change = yes } }
		start_event = { trigger_once = yes sound = { soundeffect = "stellarites_idle_drone" } }
	}

	# 吐息三段：begin 蓄力张嘴 / loop 持续张嘴 / end 闭嘴收势
	state = { name = "breath_begin" animation = "breath_begin" animation_blend_time = 0.5 looping = no }
	state = { name = "breath_loop" animation = "breath_loop" animation_blend_time = 0.5 }
	state = { name = "breath_end" animation = "breath_end" animation_blend_time = 0.5 looping = no }

	# 恒星光束：复用 breath_loop 张嘴动画，特效挂嘴部定位点 xl_gun_01
	state = { name = "beam_fire" animation = "breath_loop" animation_blend_time = 0.5 looping = no
		event = { time = 0.2 node = "xl_gun_01" particle = "stellarite_titan_muzzle_windup" trigger_once = yes }
		event = { time = 0.2 trigger_once = yes sound = { soundeffect = "stellarites_windup_beam" } }
		event = { time = 0.8 node = "xl_gun_01" particle = "stellarite_titan_muzzle_particle" trigger_once = yes }
		event = { time = 0.8 trigger_once = yes sound = { soundeffect = "stellarites_fire_beam" } }
		event = { time = 0.8 trigger_once = yes sound = { soundeffect = "distance_stellarites_fire_beam" } }
	}

	scale = 0.5

	game_data = {
		uv_animation_speed 		= 10.0
		uv_animation_direction 	= { 0.0 0.02 }
		bloom_factor = 2
	}
}

entity = {
	name = "lev_stellarite_entity"
	pdxmesh = "locator_mesh"
	cull_radius = 10.0

	locator = { name = "part1" }

	default_state = "idle"
	state = { name = "idle" state_time = 6 }
	state = { name = "moving" state_time = 6 }
	state = { name = "death" state_time = 3 looping = no }

  	game_data = {
		size = 30.0
	  	raytrace_projectiles = no
  		dissolve_on_death = 3.0
		ship_color = hsv { 0.11 1.0 0.75 1.0 }
	}

	scale = 3
}

animation = {
	name = "lev_stellarite_idle_animation"
	file = "stellarite_idle.anim"
}

animation = {
	name = "lev_stellarite_moving_animation"
	file = "stellarite_moving.anim"
}

animation = {
	name = "lev_stellarite_death_animation"
	file = "stellarite_death.anim"
}

animation = {
	name = "lev_stellarite_attack_animation"
	file = "stellarite_attack.anim"
}

animation = {
	name = "lev_stellarite_breath_begin_animation"
	file = "stellarite_breath_begin.anim"
}

animation = {
	name = "lev_stellarite_breath_loop_animation"
	file = "stellarite_breath_loop.anim"
}

animation = {
	name = "lev_stellarite_breath_end_animation"
	file = "stellarite_breath_end.anim"
}
