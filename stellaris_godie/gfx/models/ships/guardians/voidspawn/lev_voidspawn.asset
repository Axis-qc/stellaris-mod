# 利维坦·虚空孳孽 实体与动画（mod 独立定义，全用 lev_voidspawn_* 前缀，不覆盖原版）
# section entity 从原版 leviathan_01_voidspawn_section_entity 镜像：状态集、死亡粒子 event、locator 照抄，音效省略
# 原版 voidspawn 无 attach 副实体（单段模型），克隆无 attach
# 注意：.anim 按声明处目录解析，引用的原版动画已全部复制进本目录

# ── section entity（镜像原版 leviathan_01_voidspawn_section_entity）──
entity = {
	name = "lev_voidspawn_section_entity"
	pdxmesh = "lev_voidspawn_mesh"
	cull_radius = 100.0
	locator = { name = "spine" }

	default_state = "idle"
	state = { name = "idle" animation = "idle" animation_blend_time = 1 looping = no next_state = "idle"
	}
	state = { name = "moving" animation = "moving" animation_blend_time = 0.5 looping = no next_state = "moving"
	}
	state = { name = "death" animation = "death" looping = no animation_blend_time = 0.3
		event = { time = 1.2 node = "head" particle = "distant_stars_gib_explosion_effect" keep_particle = yes trigger_once = yes }
	}
}

# ── 舰船 entity（镜像原版 leviathan_01_voidspawn_entity）──
entity = {
	name = "lev_voidspawn_entity"
	pdxmesh = "locator_mesh"
	cull_radius = 100.0

	locator = { name = "spine" }

	default_state = "idle"
	state = { name = "idle" state_time = 5 }
	state = { name = "moving" state_time = 5 }
	state = { name = "combat_moving" state_time = 5 }
	state = { name = "attack" state_time = 3 looping = no }
	state = { name = "death" state_time = 5 looping = no }

	game_data = {
		raytrace_projectiles = no
		dissolve_on_death = 8.0
		ship_color = hsv { 0.83 0.9 0.6 1.0 }
	}

	scale = 1.0
}

# ── 动画注册（file 写裸文件名，按声明处目录解析为本目录）──
animation = {
	name = "lev_voidspawn_idle_animation"
	file = "leviathan_01_voidspawn_idle.anim"
}

animation = {
	name = "lev_voidspawn_moving_animation"
	file = "leviathan_01_voidspawn_moving.anim"
}

animation = {
	name = "lev_voidspawn_death_animation"
	file = "leviathan_01_voidspawn_death.anim"
}
