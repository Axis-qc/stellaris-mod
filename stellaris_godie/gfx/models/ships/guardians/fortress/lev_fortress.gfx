# 利维坦·神秘堡垒 独立 pdxmesh（不覆盖原版 ancient_station_xl_mesh）
# meshsettings 逐字照抄原版 ancient_station.gfx 的 ancient_station_xl_mesh 段
# 原版 XL 区段实体无动画引用，本 mesh 不注册动画；后续做动画时在此追加

objectTypes = {
	pdxmesh = {
		name = "lev_fortress_mesh"
		file = "gfx/models/ships/guardians/ancient_station/ancient_station_xl.mesh"
		scale = 1.0

		meshsettings = {
			name = "polySurface1036Shape"
			index = 0
			texture_diffuse = "ancient_space_station_diffuse.dds"
			texture_normal = "ancient_space_station_normal.dds"
			texture_specular = "ancient_space_station_specular.dds"
			shader = "PdxMeshShip"
		}
	}
}
