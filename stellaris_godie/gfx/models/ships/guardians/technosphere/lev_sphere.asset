# 利维坦·无限神机 实体与动画（mod 独立定义，全用 lev_sphere_* 前缀，不覆盖原版）
# section entity 从原版 techno_sphere_hull_entity 镜像：开合状态机（closed/opening/opened + chance 权重）、
# 开启粒子、死亡爆炸 event 照抄，音效省略；原版炮塔 attach 副实体因槽位全换 invisible_* 而省略
# 舰船 entity 从原版 techno_sphere_entity 镜像：locator_mesh + part1，game_data.size 照抄
# 注意：.anim 按声明处目录解析，引用的原版动画已全部复制进本目录

# ── section entity（镜像原版 techno_sphere_hull_entity，能量体开合状态机）──
entity = {
	name = "lev_sphere_section_entity"
	pdxmesh = "lev_sphere_mesh"

	default_state = "idle"
	state = { name = "idle"		animation = "closed" animation_blend_time = 0 looping = no next_state = "idle"
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"combat_idle" = 0
				"combat_moving" = 0
			}
			default = 1
		}
	}
	state = { name = "idle"		animation = "closing" animation_blend_time = 0 looping = no next_state = "idle"
		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"combat_idle" = 100
				"combat_moving" = 100
			}
			default = 0
		}
	}

	state = { name = "combat_idle"		animation = "opening" animation_blend_time = 0 looping = no next_state = "combat_idle"
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"combat_idle" = 0
				"combat_moving" = 0
			}
			default = 0
		}
	}
	state = { name = "combat_idle"		animation = "opened" animation_blend_time = 0 looping = no next_state = "combat_idle"
		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"combat_idle" = 100
				"combat_moving" = 100
			}
			default = 1
		}
	}
	state = { name = "combat_moving"		animation = "opening" animation_blend_time = 0 looping = no next_state = "combat_moving"
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"combat_idle" = 0
				"combat_moving" = 0
			}
			default = 0
		}
	}
	state = { name = "combat_moving"		animation = "opened" animation_blend_time = 0 looping = yes next_state = "combat_moving"
		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"combat_idle" = 100
				"combat_moving" = 100
			}
			default = 1
		}
	}
	state = { name = "moving"		animation = "closing" animation_blend_time = 0 looping = no next_state = "moving"
		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"combat_idle" = 100
				"combat_moving" = 100
			}
			default = 0
		}
	}
	state = { name = "moving"		animation = "closed" animation_blend_time = 0 looping = yes next_state = "moving"
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"combat_idle" = 0
				"combat_moving" = 0
			}
			default = 1
		}
	}

	state = { name = "death"		animation = "death" looping = no
		event = { time = 0.0 node = "explosion_01" particle = "large_ship_explosion_particle" keep_particle = yes trigger_once = yes }
		event = { time = 0.0 node = "explosion_01" particle = "large_ship_burn_particle" keep_particle = yes trigger_once = yes }

		event = { time = 0.3 node = "explosion_03" particle = "large_ship_explosion_particle" keep_particle = yes trigger_once = yes }
		event = { time = 0.3 node = "explosion_03" particle = "large_ship_burn_particle" keep_particle = yes trigger_once = yes }

		event = { time = 0.6 node = "explosion_05" particle = "large_ship_explosion_particle" keep_particle = yes trigger_once = yes }
		event = { time = 0.6 node = "explosion_05" particle = "large_ship_burn_particle" keep_particle = yes trigger_once = yes }

		event = { time = 0.8 node = "explosion_07" particle = "large_ship_explosion_particle" keep_particle = yes trigger_once = yes }
		event = { time = 0.8 node = "explosion_07" particle = "large_ship_burn_particle" keep_particle = yes trigger_once = yes }

		event = { time = 1.0 node = "explosion_09" particle = "large_ship_explosion_particle" keep_particle = yes trigger_once = yes }
		event = { time = 1.0 node = "explosion_09" particle = "large_ship_burn_particle" keep_particle = yes trigger_once = yes }

		event = { time = 1.2 node = "explosion_014" particle = "large_ship_explosion_particle" keep_particle = yes trigger_once = yes }
		event = { time = 1.2 node = "explosion_014" particle = "large_ship_burn_particle" keep_particle = yes trigger_once = yes }

		event = { time = 1.4 node = "explosion_013" particle = "large_ship_explosion_particle" keep_particle = yes trigger_once = yes }
		event = { time = 1.4 node = "explosion_013" particle = "large_ship_burn_particle" keep_particle = yes trigger_once = yes }

		event = { time = 1.8 node = "explosion_015" particle = "large_ship_explosion_particle" keep_particle = yes trigger_once = yes }
		event = { time = 1.8 node = "explosion_015" particle = "large_ship_burn_particle" keep_particle = yes trigger_once = yes }

		event = { time = 2.1 node = "explosion_017" particle = "large_ship_explosion_particle" keep_particle = yes trigger_once = yes }
		event = { time = 2.1 node = "explosion_017" particle = "large_ship_burn_particle" keep_particle = yes trigger_once = yes }

		event = { time = 2.7 node = "explosion_020" particle = "large_ship_explosion_particle" keep_particle = yes trigger_once = yes }
		event = { time = 2.7 node = "explosion_020" particle = "large_ship_burn_particle" keep_particle = yes trigger_once = yes }

		event = { time = 3.0 node = "explosion_021" particle = "large_ship_explosion_particle" keep_particle = yes trigger_once = yes }
		event = { time = 3.0 node = "explosion_021" particle = "large_ship_burn_particle" keep_particle = yes trigger_once = yes }

		event = { time = 3.5 node = "explosion_024" particle = "large_ship_explosion_particle" keep_particle = yes trigger_once = yes }
		event = { time = 3.5 node = "explosion_024" particle = "large_ship_burn_particle" keep_particle = yes trigger_once = yes }

		event = { time = 3.8 node = "explosion_02" particle = "large_ship_explosion_particle" keep_particle = yes trigger_once = yes }
		event = { time = 3.8 node = "explosion_02" particle = "large_ship_burn_particle" keep_particle = yes trigger_once = yes }

		event = { time = 4.86 node = "top_explosion" particle = "large_ship_explosion_particle" keep_particle = yes trigger_once = yes }
	}
}

# ── 舰船 entity（镜像原版 techno_sphere_entity，locator_mesh）──
entity = {
	name = "lev_sphere_entity"
	pdxmesh = "locator_mesh"

	locator = { name = "part1"			position = {  0 0 0	} }

	default_state = "idle"
	state = { name = "idle" state_time = 5 }
	state = { name = "moving" state_time = 5 }
	state = { name = "combat_moving" state_time = 5 }
	state = { name = "attack" state_time = 3 looping = no }
	state = { name = "death" state_time = 11 looping = no
		event = { time = 10.9 node = "part1" particle = "technosphere_explosion_particle" keep_particle = yes trigger_once = yes }
	}

	game_data = {
		size = 30
	}
}

# ── 动画注册（file 写裸文件名，按声明处目录解析为本目录）──
animation = {
	name = "lev_sphere_opened_animation"
	file = "technosphere_opened.anim"
}

animation = {
	name = "lev_sphere_closed_animation"
	file = "technosphere_closed.anim"
}

animation = {
	name = "lev_sphere_opening_animation"
	file = "technosphere_opening.anim"
}

animation = {
	name = "lev_sphere_closing_animation"
	file = "technosphere_closing.anim"
}

animation = {
	name = "lev_sphere_death_animation"
	file = "technosphere_death.anim"
}
