# 噬天巨兽吞噬星球：星球侧粒子（星球被剥离 / 物质被吸向巨兽嘴部）。
# 由 br.6001 建的星球位环境物体引用；缩放 = 星球显示尺寸 x 0.02（同 defines 的
# PLANET_DESTRUCTION_HIT_ENTITY_SCALE，即引擎给 planet_hit_entity 的那套）。
#
# 坐标约定（写错就废）：+X = 朝星球内部（出生偏移 position={ x=24 }）；
#   +Z = 朝巨兽 —— 环境物体朝向由 br.6001 的 entity_face_object = from 定，
#   引擎给 planet_hit_entity 的那套是 -Z，两者相反，勿混。
# 子系统 1~4 带 force=attractor（被吸向嘴部），5~8 不带（原地翻涌 / 外扩）。
# 坑：force 块必须在子系统里用 force=<名字> 引用才生效；数值二元组是「值 方差」不是「最小 最大」；
#   trail=yes 会把贴图拉成细线；暗色块必须 shader="ParticleAlphaBlend" + sort="depth"（additive 画不出黑）。
# 调参：attractor 的 amount 管吸力（负值=吸引），emission / max_amount 管粒子量。
# 注：子系统 position 用具名分量 x=/y=/z=，空格三元组是 force 块的专用写法。

particle={
	name="kaiju_gobble_planet_file"

	# 1) 被啃食处的高热翻腾
	subsystem={
		name="surface_churn"
		max_amount=25
		slave_particles=0
		emitter_type="point"
		invert=no
		trail=no
		local_space=yes
		billboard=no
		hide=no
		texture={
			file="gfx/particles/fire05.dds"
			x=2
			y=2
			shader="ParticleAdditive"
		}
		color={
			x=255.000
			y=140.000
			z=110.000
			alpha=110.000,alpha_fade
		}
        position={
            x=24.000
            y=0.000
            z=0.000
        }
		duration=-1.000
		velocity_pitch={ 0.000 180.000 }
		velocity_yaw={ 180.000 180.000 }
		velocity=0.500
		life=2.000
		emission=10.000
		size={ 30.000,flare_size 5.000 }
		particle_yaw={ 90.000 10.000 }
		particle_pitch={ 0.000 180.000 }
		rotation={ 0.000 180.000 }
	}

	# 2) 主物质流（被吸力拉成柱升向巨兽嘴部）
	subsystem={
		name="matter_stream"
		max_amount=1500
		slave_particles=0
		emitter_type="sphere"
		sphere_emitter_radius={ 24.000 8.000 }
		sphere_emitter_yaw={ 0.000 180.000 }
		sphere_emitter_pitch={ 0.000 180.000 }
		invert=no
		trail=no
		local_space=yes
		billboard=yes
		hide=no
		texture={
			file="gfx/particles/glow.dds"
			x=1
			y=1
			shader="ParticleAdditive"
		}
		color={
			x=255.000
			y=225.000
			z=170.000
			alpha=190.000,alpha_fade
		}
        position={
            x=24.000
            y=0.000
            z=0.000
        }
		duration=-1.000
		velocity=0.000
		life={ 10.000 0.400 }
		emission=75.000
		size={ 7.000,shrink 3.000 }
		rotation={ 0.000 180.000 }
		force=attractor
	}

	# 3) 亮屑（更小更亮、升得更低，负责速度感）
	subsystem={
		name="sparks"
		max_amount=800
		slave_particles=0
		emitter_type="sphere"
		sphere_emitter_radius={ 22.000 6.000 }
		sphere_emitter_yaw={ 0.000 180.000 }
		sphere_emitter_pitch={ 0.000 180.000 }
		invert=no
		trail=no
		local_space=yes
		billboard=yes
		hide=no
		texture={
			file="gfx/particles/glow.dds"
			x=1
			y=1
			shader="ParticleAdditive"
		}
		color={
			x=255.000
			y=180.000
			z=120.000
			alpha=220.000,alpha_fade
		}
        position={
            x=24.000
            y=0.000
            z=0.000
        }
		duration=-1.000
		velocity=0.000
		life={ 10.000 0.300 }
		emission=42.000
		size={ 2.500,shrink 1.000 }
		rotation={ 0.000 180.000 }
		force=attractor
	}

	# 4) 掀板（整块土石被拽起）
	subsystem={
		name="dust"
		max_amount=450
		slave_particles=0
		emitter_type="sphere"
		sphere_emitter_radius={ 36.000 10.000 }
		sphere_emitter_yaw={ 0.000 180.000 }
		sphere_emitter_pitch={ 0.000 180.000 }
		invert=no
		trail=no
		local_space=yes
		billboard=yes
		hide=no
		texture={
			file="gfx/particles/cloud.dds"
			x=1
			y=1
			shader="ParticleAdditive"
		}
		color={
			x=255.000
			y=140.000
			z=110.000
			alpha=80.000,alpha_fade
		}
        position={
            x=24.000
            y=0.000
            z=0.000
        }
		duration=-1.000
		velocity=0.000
		life={ 12.000 0.400 }
		emission=22.000
		size={ 26.000,grow 6.000 }
		rotation={ 0.000 180.000 }
		rotation_speed=30.000
		force=attractor
	}

	# 5) 全球地表熔融
	subsystem={
		name="global_melt"
		max_amount=200
		slave_particles=0
		emitter_type="sphere"
		sphere_emitter_radius={ 24.000 3.000 }
		sphere_emitter_yaw={ 0.000 180.000 }
		sphere_emitter_pitch={ 0.000 180.000 }
		invert=no
		trail=no
		local_space=yes
		billboard=yes
		hide=no
		texture={
			file="gfx/particles/fire05.dds"
			x=2
			y=2
			shader="ParticleAdditive"
		}
		color={
			x=255.000
			y=120.000
			z=80.000
			alpha=70.000,alpha_fade
		}
		position={
			x=0.000
			y=0.000
			z=0.000
		}
		duration=-1.000
		velocity=0.000
		life={ 1.600 0.400 }
		emission=40.000
		size={ 18.000,flare_size 4.000 }
		rotation={ 0.000 180.000 }
	}

	# 6) 大气剥离层
	subsystem={
		name="atmosphere"
		max_amount=200
		slave_particles=0
		emitter_type="sphere"
		sphere_emitter_radius={ 30.000 5.000 }
		sphere_emitter_yaw={ 0.000 180.000 }
		sphere_emitter_pitch={ 0.000 180.000 }
		invert=no
		trail=no
		local_space=yes
		billboard=yes
		hide=no
		texture={
			file="gfx/particles/cloud_low_alpha.dds"
			x=1
			y=1
			shader="ParticleAdditive"
		}
		color={
			x=210.000
			y=225.000
			z=255.000
			alpha=45.000,alpha_fade
		}
		position={
			x=0.000
			y=0.000
			z=0.000
		}
		duration=-1.000
		velocity_pitch={ 0.000 180.000 }
		velocity_yaw={ 0.000 180.000 }
		velocity=0.250
		life={ 9.000 0.500 }
		emission=25.000
		size={ 40.000,grow 8.000 }
		rotation={ 0.000 180.000 }
	}

	# 7) 炽热裂纹
	subsystem={
		name="cracks"
		max_amount=150
		slave_particles=0
		emitter_type="sphere"
		sphere_emitter_radius={ 23.000 2.000 }
		sphere_emitter_yaw={ 0.000 180.000 }
		sphere_emitter_pitch={ 0.000 180.000 }
		invert=no
		trail=no
		local_space=yes
		billboard=yes
		hide=no
		texture={
			file="gfx/particles/lava_trail.dds"
			x=1
			y=1
			shader="ParticleAdditive"
		}
		color={
			x=255.000
			y=90.000
			z=50.000
			alpha=150.000,alpha_fade
		}
		position={
			x=0.000
			y=0.000
			z=0.000
		}
		duration=-1.000
		velocity=0.000
		life={ 3.000 0.600 }
		emission=16.000
		size={ 6.000,shrink 2.500 }
		rotation={ 0.000 180.000 }
	}

	# 8) 黑色土石块（跟着物质流被吸上去）
	subsystem={
		name="rock_chunks"
		max_amount=300
		slave_particles=0
		sort="depth"
		emitter_type="sphere"
		sphere_emitter_radius={ 24.000 8.000 }
		sphere_emitter_yaw={ 0.000 180.000 }
		sphere_emitter_pitch={ 0.000 180.000 }
		invert=no
		trail=no
		local_space=yes
		billboard=yes
		hide=no
		texture={
			file="gfx/particles/shards_2.dds"
			x=4
			y=4
			shader="ParticleAlphaBlend"
		}
		color={
			x=38.000
			y=32.000
			z=28.000
			alpha=255.000,alpha_fade
		}
		position={
			x=24.000
			y=0.000
			z=0.000
		}
		duration=-1.000
		velocity=0.000
		life={ 10.000 0.400 }
		emission=26.000
		size={ 9.000,shrink 1.500 }
		rotation={ 0.000 180.000 }
		rotation_speed=35.000
		force=attractor
	}

	animation={
		name="alpha_fade"
		start=0.000
		duration=1.000
		repeat=no
		minValue=0.000
		maxValue=1.000
		curve={
			0.000 0.000 0.150 0.900 0.700 0.750 1.000 0.000
		}
		op="MUL"
		time="life"
	}

	animation={
		name="flare_size"
		start=0.000
		duration=1.000
		repeat=no
		minValue=0.000
		maxValue=1.000
		curve={
			0.000 0.300 1.000 1.000
		}
		op="MUL"
		time="life"
	}

	animation={
		name="shrink"
		start=0.000
		duration=1.000
		repeat=no
		minValue=0.000
		maxValue=1.000
		curve={
			0.000 1.000 0.700 0.850 1.000 0.100
		}
		op="MUL"
		time="life"
	}

	animation={
		name="grow"
		start=0.000
		duration=1.000
		repeat=no
		minValue=0.000
		maxValue=1.000
		curve={
			0.000 0.400 0.600 0.900 1.000 1.000
		}
		op="MUL"
		time="life"
	}

	# 吸力：把粒子吸向巨兽嘴部（+Z 方向）。position = 嘴部局部坐标，amount 负值=吸引。
	force={
		type="point"
		name="attractor"
		position={
			0.000 0.000 200.000
		}
		direction={
			0.000 0.000 1.000
		}
		local_force=yes
		yaw=0.000
		division=16
		amount=-4.000
	}

}
