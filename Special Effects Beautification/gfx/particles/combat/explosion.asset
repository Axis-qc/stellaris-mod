particle = {
    name = "explosion"
    # Halo (shockwave)
    subsystem = {
        # values that can be curves or values, with or without variation
        # always local time

        # fixed values, cannot be curves, cannot add variation
        max_amount = 1

        sort = "depth"
        #invert = yes
        texture = {
            shader = "ParticleAdditive"   #ParticleAdditive   #ParticleAlphaBlend
            file = "gfx/particles/bubble.dds"
            #x = 2
            #y = 2
        }

        position = { x = 0 y = 0 z = 0 }
        emitter_yaw = { 0 0 }
        emitter_pitch = { 0 0 }

        start = 0
        duration = 0.1
        emission = { 1000 }

        velocity = { 0 }
        velocity_pitch = { 20 0 }
        velocity_yaw = { 0 180 }

        rotation = { spin 180 }

        life = { 0.8 }
        size = { 0,flash_size }

        # values that can be curves or values, with or without variation
        # 'spawn'/'system'/'particle' time is valid

        color = {
            r = { 255 }
            g = { 200 }
            b = { 100 }
            alpha = { 200,flash_fade }
        }
    }

    # Spawn
    # System
    # Life
    # Life_abs
    animation = {
        time = "life_abs"
        name = "spin"
        start = 0
        duration = 7
        repeat = yes
        op = "MUL" # "MUL"/"ADD"/"ABS"
        minValue = 0
        maxValue = 2
        curve = {
            0 0
            1 1
        }
    }
    animation = {
        time = "life_abs"
        name = "spin2"
        start = 0
        duration = 7
        repeat = yes
        op = "MUL" # "MUL"/"ADD"/"ABS"
        minValue = 0
        maxValue = 4
        curve = {
            0 0
            1 1
        }
    }
    animation = {
        time = "life"
        name = "flash_size"
        start = 0
        duration = 1
        #repeat = yes
        op = "ABS" # "MUL"/"ADD"/"ABS"
        minValue = 0
        maxValue = 4
        curve = {
            0 0
            0.25 0.8
            0.75 0.9
            1 1
        }
    }
    animation = {
        time = "life"
        name = "flash_fade"
        start = 0
        duration = 1
        #repeat = yes
        op = "MUL" # "MUL"/"ADD"/"ABS"
        minValue = 0
        maxValue = 1
        curve = {
            0 1
            1 0
        }
    }
    animation = {
        time = "life"
        name = "glowy_bit_fade"
        start = 0
        duration = 1
        #repeat = yes
        op = "MUL" # "MUL"/"ADD"/"ABS"
        minValue = 0
        maxValue = 1
        curve = {
            0 0.7
            0.75 1
            1 0
        }
    }
    # planar
    # turbulence
    # friction
    # vortex
    # point
    force = {
        type = "friction"
        name = "drag2"
        amount = 2.0 #,delayed_force

    }
}


particle = {
    name = "explosion"  # 粒子系统名称：爆炸效果

    # 光环（冲击波）效果子系统
    subsystem = {

        # 可以是曲线或值的参数，可以带有或不带有变化
        # 始终使用本地时间

        # 固定值，不能是曲线，不能添加变化
        max_amount = 1  # 最大粒子数量

        sort = "depth"  # 粒子排序方式：按深度排序
        #invert = yes  # 是否反转（已被注释掉）
        texture = {
            shader = "ParticleAdditive"   # 着色器类型：ParticleAdditive（加法混合，用于发光效果）或 ParticleAlphaBlend（透明度混合）
            file = "gfx/particles/bubble.dds"   # 使用的纹理文件
            #x = 2	# 纹理X方向平铺（已被注释掉）
            #y = 2	# 纹理Y方向平铺（已被注释掉）
        }

        position = { x = 0 y = 0 z = 0 }  # 发射器位置（原点）
        emitter_yaw = { 0 0 }  # 发射器偏航角范围（固定为0度）
        emitter_pitch = { 0 0 }  # 发射器俯仰角范围（固定为0度）

        start = 0                # 开始时间（0秒）
        duration = 0.1  # 发射持续时间（0.1秒）
        emission = { 1000 }  # 发射率（每秒1000个粒子）

        velocity = { 0 }  # 初始速度大小（0）
        velocity_pitch = { 20 0 }  # 俯仰角速度范围（20度，无变化）
        velocity_yaw = { 0 180 }  # 偏航角速度范围（0-180度随机）

        rotation = { spin 180 }  # 初始旋转（使用"spin"参数，范围180度）

        life = { 0.8 }  # 粒子生命周期（0.8秒）
        size = { 0,flash_size }  # 粒子大小（初始为0，使用"flash_size"动画曲线）

        # 可以是曲线或值的参数，可以带有或不带有变化
        # 可以使用'spawn'（生成）/'system'（系统）/'particle'（粒子）时间

        color = {
            # 粒子颜色
            r = { 255 }  # 红色分量（255，最大值）
            g = { 200 }  # 绿色分量（200）
            b = { 100 }  # 蓝色分量（100）
            alpha = { 200,flash_fade }  # 透明度（初始200，使用"flash_fade"动画曲线）
        }
    }

    # 可用时间类型：
    # Spawn（生成时间）
    # System（系统时间）
    # Life（粒子生命周期，0-1标准化）
    # Life_abs（粒子绝对生命周期，实际秒数）

    # 旋转动画1
    animation = {
        time = "life_abs"  # 使用粒子的绝对生命周期作为时间基准
        name = "spin"  # 动画名称（在rotation参数中被引用）
        start = 0  # 动画开始时间
        duration = 7  # 动画持续时间（7秒）
        repeat = yes  # 是否重复播放
        op = "MUL"  # 操作类型："MUL"（乘法）/ "ADD"（加法）/ "ABS"（绝对值）
        minValue = 0  # 最小值
        maxValue = 2  # 最大值
        curve = {
            # 动画曲线
            0 0  # 时间点0.0，值0.0
            1 1  # 时间点1.0，值1.0
        }
    }

    # 旋转动画2
    animation = {
        time = "life_abs"  # 使用粒子的绝对生命周期作为时间基准
        name = "spin2"  # 动画名称
        start = 0  # 动画开始时间
        duration = 7  # 动画持续时间（7秒）
        repeat = yes  # 是否重复播放
        op = "MUL"  # 操作类型：乘法
        minValue = 0  # 最小值
        maxValue = 4  # 最大值
        curve = {
            # 动画曲线
            0 0  # 时间点0.0，值0.0
            1 1  # 时间点1.0，值1.0
        }
    }

    # 闪光大小动画
    animation = {
        time = "life"  # 使用粒子的标准化生命周期作为时间基准（0-1）
        name = "flash_size"  # 动画名称（在size参数中被引用）
        start = 0  # 动画开始时间
        duration = 1  # 动画持续时间（1秒）
        #repeat = yes  # 是否重复播放（已被注释掉）
        op = "ABS"  # 操作类型：绝对值
        minValue = 0  # 最小值
        maxValue = 4  # 最大值
        curve = {
            # 动画曲线
            0 0  # 时间点0.0，值0.0（大小开始为0）
            0.25 0.8  # 时间点0.25，值0.8（快速增大）
            0.75 0.9  # 时间点0.75，值0.9（保持较大）
            1 1  # 时间点1.0，值1.0（结束时为最大值）
        }
    }

    # 闪光淡出动画
    animation = {
        time = "life"  # 使用粒子的标准化生命周期作为时间基准
        name = "flash_fade"  # 动画名称（在alpha参数中被引用）
        start = 0  # 动画开始时间
        duration = 1  # 动画持续时间（1秒）
        #repeat = yes  # 是否重复播放（已被注释掉）
        op = "MUL"  # 操作类型：乘法
        minValue = 0  # 最小值
        maxValue = 1  # 最大值
        curve = {
            # 动画曲线
            0 1  # 时间点0.0，值1.0（开始时不透明）
            1 0  # 时间点1.0，值0.0（结束时完全透明）
        }
    }

    # 发光部分淡出动画
    animation = {
        time = "life"  # 使用粒子的标准化生命周期作为时间基准
        name = "glowy_bit_fade"  # 动画名称
        start = 0  # 动画开始时间
        duration = 1  # 动画持续时间（1秒）
        #repeat = yes  # 是否重复播放（已被注释掉）
        op = "MUL"  # 操作类型：乘法
        minValue = 0  # 最小值
        maxValue = 1  # 最大值
        curve = {
            # 动画曲线
            0 0.7  # 时间点0.0，值0.7（开始时部分透明）
            0.75 1  # 时间点0.75，值1.0（中间阶段完全不透明）
            1 0  # 时间点1.0，值0.0（结束时完全透明）
        }
    }
    # 可用的力场类型：
    # planar（平面）
    # turbulence（湍流）
    # friction（摩擦力）
    # vortex（涡流）
    # point（点）

    # 摩擦力效果
    force = {
        type = "friction"  # 力场类型：摩擦力
        name = "drag2"  # 力场名称
        amount = 2.0 #,delayed_force  # 力场强度（2.0），可能引用"delayed_force"动画（已被注释掉）
    }
}