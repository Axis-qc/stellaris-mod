entity = {
    name = "stormfire_auto_cannons_l_entity"
    pdxmesh = "no_weapon_entity"

    cull_radius = 1.0

    default_state = idle
    state = {
        name = "idle" #animation = "idle"
        event = { time = 0 node = ROOT particle = "stormfire_auto_cannons_effect" keep_particle = yes }
    }
    scale = 6
}

#电弧特效 参考ASB
entity = {
    name = "focused_arc_emitter_entity"
    pdxmesh = "no_weapon_entity"

    cull_radius = 200.0    # 渲染剔除半径 (摄像机距离超过此值时不渲染此实体)
    default_state = idle
    state = {
        name = "idle" #animation = "idle"
        state_time = 10 looping = no
        event = { time = 0 node = exhaust particle = "focused_arc_emitter_effect" keep_particle = yes }
        # event = { time = 0 particle = "focused_arc_emitter_effect" keep_particle = yes }
    }
    state = {
        name = "stop"
        looping = no
        #state_time = 2.0
        chance = 1
        #animation = "miss"
        time_offset = { 0 1.5 }
        #animation_blend_time = 0.5
        start_event = { trigger_once = yes time = 0 node = exhaust particle = "focused_arc_emitter_effect" keep_particle = yes }
    }

    scale = 1
}

