    }
    state = {
        name = "stop"
        looping = no
        #state_time = 2.0
        chance = 1
        #animation = "miss"
        time_offset = { 0 1.5 }
        #animation_blend_time = 0.5
        start_event = { trigger_once = yes time = 0 node = exhaust particle = "ex_jiguang_weapon_1" keep_particle = yes }
    }
    scale = 1
}
