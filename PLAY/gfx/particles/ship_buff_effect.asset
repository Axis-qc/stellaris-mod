        }
        direction = {
            0.000 1.000 0.000
        }
        local_force = yes
        yaw = 0.000
        division = 16
        amount = 5.000
    }
    #内环旋转
    force = {
        name = xuanzhuan
        type = spin
        # spin
        # point
        # vortex
        # turbulence
        # friction
        # planar
        position = {
            0.000 0.000 0.000
        }
        direction = {
            0.000 1.000 0.000
        }
        local_force = yes
        yaw = 0
        division = 20
        amount = 0.1
    }
    #外环
    force = {
        name = xuanzhuan1
        type = spin
        # spin
        # point
        # vortex
        # turbulence
        # friction
        # planar
        position = {
            0.000 0.000 0.000
        }
        direction = {
            0.000 -1.000 0.000
        }
        local_force = yes
        yaw = 0
        division = 20
        amount = 0.05
    }
    #最外环
    force = {
        name = xuanzhuan2
        type = spin
        # spin
        # point
        # vortex
        # turbulence
        # friction
        # planar
        position = {
            0.000 0.000 0.000
        }
        direction = {
            0.000 1.000 0.000
        }
        local_force = yes
        yaw = 0
        division = 20
        amount = 0.05
    }
    # 控制红色通道：从0→1（增强到最大）→0（消退），与蓝色反向同步
    animation = {
        name = "color_red"
        start = 0.000
        duration = 10.000  # 总时长10秒，与蓝色动画同步
        repeat = yes
        minValue = 0.000
        maxValue = 1.000
        curve = {
            0.000 0.000    # 0秒：红色=255×0=0（不显示，初始无红色）
            0.300 1.000    # 3秒：红色=255×1=255（最大，完全红色）
            0.700 1.000    # 7秒：保持红色最大（持续4秒纯红色）
            1.000 0.000   # 10秒：红色=0（完全消退）
        }
        op = "MUL"  # 红色最终值 = 基础x值（255）× 动画值
        time = "system"
    }

    # 控制蓝色通道：从1→0（消退）→1（恢复），与红色反向同步
    animation = {
        name = "color_blue"
        start = 0.000
        duration = 10.000  # 与红色动画时长一致，确保同步
        repeat = yes
        minValue = 0.000
        maxValue = 1.000
        curve = {
            0.000 1.000    # 0秒：蓝色=255×1=255（最大，初始纯蓝色）
            0.300 0.000    # 3秒：蓝色=0（完全消退，此时红色最大）
            0.700 0.000    # 7秒：保持蓝色消退（红色持续时无蓝色）
            1.000 1.000   # 10秒：蓝色=255（完全恢复，回到初始纯蓝色）
        }
        op = "MUL"  # 蓝色最终值 = 基础z值（255）× 动画值
        time = "system"
    }
}

#彩虹光环
particle = {
    name = "ww_ship_rainbow_effect"
    #0
    subsystem = {
        name = "icon"  # 子系统名称
        max_amount = 1  # 最大粒子数量为1（只生成一个粒子）
        slave_particles = 1  # 从粒子数量（通常用于复杂效果）
        sort = "depth"  # 粒子排序方式：按深度（用于正确渲染）
        emitter_type = "point"  # 发射器类型：点发射器（粒子从单个点发射）
        invert = no  # 不反转粒子方向
        trail = no  # 不是拖尾效果
        local_space = yes  # 本地坐标系（粒子随船移动）
        billboard = no  # 非广告牌效果（粒子保持固定方向）
        hide = no  # 不隐藏粒子

        # 纹理配置
        texture = {
            file = "gfx/particles/yuan2048.dds"  # 粒子纹理文件
            x = 1  # 纹理网格X分割数
            y = 1  # 纹理网格Y分割数
            shader = "ParticleAdditive"  # 粒子着色器（叠加混合模式）
        }

        # 颜色配置（基础值均为255，通过动画调整实际颜色）
        color = {
            x = 255.000, color_r1  # 红色通道（主色），绑定到动画变量color_r1
            y = 255.000, color_g1  # 绿色通道（辅助色），绑定到动画变量color_g1
            z = 255.000, color_b1  # 蓝色通道（辅助色），绑定到动画变量color_b1
            alpha = 200.000  # 固定透明度（200/255≈78%不透明）
        }

        # 发射器位置（相对于父对象）
        position = {
            x = 0.000  # X轴位置（中心）
            y = 10.000  # Y轴位置（向上偏移10单位）
            z = 0.000  # Z轴位置（中心）
        }

        start = 0.000  # 粒子系统启动时间（0秒立即开始）
        duration = -1.000  # 持续时间（-1表示永久存在）

        # 发射器角度范围
        emitter_yaw = { 0.000 0.000 }   # 偏航角范围（固定无旋转）
        emitter_pitch = { 0.000 0.000 } # 俯仰角范围（固定无旋转）

        # 粒子初始运动参数
        velocity_pitch = 90.000  # 速度俯仰角（90度=向下）
        velocity_yaw = 0.000     # 速度偏航角（0度=向前）
        velocity = 0.000         # 初始速度大小（0=静止）

        life = 900.00  # 粒子生命周期（900秒）
        emission = 10.000  # 粒子发射速率（10个/秒）
        size = 100.000  # 粒子大小（直径100单位）

        # 粒子方向参数
        particle_pitch = 90.000  # 粒子俯仰角（90度=面向下方）
        rotation = 0.000         # 初始旋转角度（0度）
        rotation_speed = 5.000   # 旋转速度（5度/秒）
    }
