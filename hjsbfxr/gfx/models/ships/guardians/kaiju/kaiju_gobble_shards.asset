# 噬天巨兽吞噬星球：碎片动画注册（6 个）。
# animation 必须定义在 .asset 里（.gfx 顶层写会报错）；与 .anim 同目录，file 就能用相对名。
# 每个 60 秒 / 15fps / 900 帧，由 kaiju_gobble_shards.gfx 里对应的 pdxmesh 引用。
# 动画内容（2026-09-18 定稿）：碎块分层起飞 -> 汇聚到高度 30 的一点 -> 再垂直升到 40；
# 全程匀速缩小，到 40 恰好缩到 0.002（消失）。方向 = 模型 +Y（导出时 Blender +Z -> 模型 +Y）。

animation = {
	name = "kaiju_gobble_shatter_animation_a"
	file = "kaiju_gobble_shatter_a.anim"
}

animation = {
	name = "kaiju_gobble_shatter_animation_b"
	file = "kaiju_gobble_shatter_b.anim"
}

animation = {
	name = "kaiju_gobble_shatter_animation_c"
	file = "kaiju_gobble_shatter_c.anim"
}

animation = {
	name = "kaiju_gobble_shatter_animation_d"
	file = "kaiju_gobble_shatter_d.anim"
}

animation = {
