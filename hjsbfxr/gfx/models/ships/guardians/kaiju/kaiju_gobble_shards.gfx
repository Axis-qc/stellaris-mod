# 星球碎片模型：300 片拆 6 个（每 mesh 上限 50 骨，各 49 碎片骨 + root），原点都在 (0,0,0)。
#
# 硬警告：
# - 贴图不写在 pdxmesh 上：按被吞噬星球类型写在 entity 的 meshsettings 里
#   （kaiju_gobble_entities.asset）；这里加 meshsettings 会和 entity 冲突。
# - 动画注册必须在 .asset（.gfx 顶层写 animation 会报错）。

objectTypes = {

	pdxmesh = {
		name = "kaiju_gobble_shards_mesh_a"
		file = "gfx/models/ships/guardians/kaiju/kaiju_gobble_shards_a.mesh"
		animation = { id = "shatter" type = "kaiju_gobble_shatter_animation_a" }
		scale = 1.0
		cull_distance = 99999999.0f
	}

	pdxmesh = {
		name = "kaiju_gobble_shards_mesh_b"
		file = "gfx/models/ships/guardians/kaiju/kaiju_gobble_shards_b.mesh"
		animation = { id = "shatter" type = "kaiju_gobble_shatter_animation_b" }
		scale = 1.0
		cull_distance = 99999999.0f
	}

	pdxmesh = {
		name = "kaiju_gobble_shards_mesh_c"
		file = "gfx/models/ships/guardians/kaiju/kaiju_gobble_shards_c.mesh"
		animation = { id = "shatter" type = "kaiju_gobble_shatter_animation_c" }
		scale = 1.0
		cull_distance = 99999999.0f
	}

	pdxmesh = {
		name = "kaiju_gobble_shards_mesh_d"
		file = "gfx/models/ships/guardians/kaiju/kaiju_gobble_shards_d.mesh"
		animation = { id = "shatter" type = "kaiju_gobble_shatter_animation_d" }
		scale = 1.0
		cull_distance = 99999999.0f
	}

	pdxmesh = {
		name = "kaiju_gobble_shards_mesh_e"
		file = "gfx/models/ships/guardians/kaiju/kaiju_gobble_shards_e.mesh"
		animation = { id = "shatter" type = "kaiju_gobble_shatter_animation_e" }
		scale = 1.0
		cull_distance = 99999999.0f
	}

	pdxmesh = {
		name = "kaiju_gobble_shards_mesh_f"
		file = "gfx/models/ships/guardians/kaiju/kaiju_gobble_shards_f.mesh"
		animation = { id = "shatter" type = "kaiju_gobble_shatter_animation_f" }
		scale = 1.0
		cull_distance = 99999999.0f
	}

	# 隐形行星：原版行星网格 + 全透明材质。必须有几何体，entity_scale_to_size 才有尺寸可算。
	# 这个 mesh 由 entity 直接引用、没有 entity 级覆盖，所以 meshsettings 留在 pdxmesh 上。
	pdxmesh = {
		name = "kaiju_gobble_planet_hidden_mesh"
		file = "gfx/models/planets/planet_non_clouded.mesh"

		meshsettings = {
			name = "planet_geosphereShape"
			texture_diffuse = "noalpha.dds"
			texture_normal = "nonormal.dds"
			texture_specular = "nospec.dds"
			shader = "PdxMeshAlphaAdditiveAnimateUV"
		}

		meshsettings = {
			name = "polesShape"
			texture_diffuse = "noalpha.dds"
			texture_normal = "nonormal.dds"
			texture_specular = "nospec.dds"
			shader = "PdxMeshAlphaAdditiveAnimateUV"
		}
	}
}
