entity = {
	name = "kaiju_gobble_shards_entity_f"
	pdxmesh = "kaiju_gobble_shards_mesh_f"
    # 渲染剔除半径 (摄像机距离超过此值时不渲染此实体)
    cull_radius = 800.0
	default_state = "idle"
	state = { name = "idle" state_time = 60 animation = "shatter" looping = no }
	state = { name = "stop" state_time = 0.5 animation = "shatter" looping = no }
}

# ---- 粒子宿主（已停用）：粒子改走独立环境物体。保留定义仅为回退，别 attach。----
entity = {
	name = "kaiju_gobble_particle_host_entity"
	scale = 0.1856

	default_state = "idle"
	state = { name = "idle" state_time = 60 looping = no
		start_event = { particle = "kaiju_gobble_planet_effect" keep_particle = yes }
	}
	state = { name = "stop" state_time = 0.5 looping = no }
}

# ---- 坐标轴标定件（临时）：红=X 绿=Y 蓝=Z。测完把 shards_entity 里的 attach 注释掉。----
entity = {
	name = "kaiju_gobble_axis_entity"
	scale = 1

	default_state = "idle"
	state = { name = "idle" state_time = 900 looping = no
		start_event = { particle = "kaiju_gobble_axis_effect" keep_particle = yes }
	}
	state = { name = "stop" state_time = 0.5 looping = no }
}

# ---- 碎片总实体：attach 6 个碎片。不设朝向、不写 pdxmesh、不写 cull_radius，
#      碎片动画沿模型 +Z 飞 = 世界竖直向上。----
entity = {
	name = "kaiju_gobble_shards_entity"
	locator = { name = "loc" position = { 0.0 0.0 0.0 } }
    scale = 1
    # 渲染剔除半径 (摄像机距离超过此值时不渲染此实体)
    cull_radius = 800.0
	attach = { loc = "kaiju_gobble_shards_entity_a" }
	attach = { loc = "kaiju_gobble_shards_entity_b" }
	attach = { loc = "kaiju_gobble_shards_entity_c" }
	attach = { loc = "kaiju_gobble_shards_entity_d" }
	attach = { loc = "kaiju_gobble_shards_entity_e" }
	attach = { loc = "kaiju_gobble_shards_entity_f" }

	# 坐标轴标定件（临时）：测完注释掉这行。
	# attach = { loc = "kaiju_gobble_axis_entity" }
}
