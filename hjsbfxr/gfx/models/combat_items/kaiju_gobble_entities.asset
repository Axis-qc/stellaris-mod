# 星球侧实体（本文件由 kb_gen_shards_materials.py 生成，别手改）。
#
# 15 个碎片贴图族，每族 6 个子实体 kaiju_gobble_shards_entity_<族>_<a..f> + 1 个父实体。
# 贴图写在 entity 的 meshsettings 上（pdxmesh 上不写，两处都写会冲突）。
#
# 硬警告：
# - 带 pdxmesh 的实体每个 state 都必须写 animation，漏一个会报
#   "State ... is missing an animation!"。
# - kaiju_gobble_particle_host_entity 已停用，别 attach；kaiju_gobble_axis_entity 是临时标定件。

# 粒子载体：只有粒子没有网格。不设朝向，吸力沿基准坐标 +Y（竖直向上）。
entity = {
	name = "kaiju_gobble_planet_hit_entity"
	cull_radius = 800.0

	default_state = "idle"
	state = { name = "idle" state_time = 60 looping = no
		start_event = { particle = "kaiju_gobble_planet_effect" keep_particle = yes }
	}
	state = { name = "stop" state_time = 0.5 looping = no }
}

# 隐形行星：原版行星网格 + 全透明材质，尺寸与真行星一致（顶掉原星球防重影）。
# 不能用 locator_mesh（无几何体）—— entity_scale_to_size 会算出 0，全部被缩没。
entity = {
	name = "kaiju_gobble_invisible_planet_entity"
	pdxmesh = "kaiju_gobble_planet_hidden_mesh"
	cull_radius = 800.0

	default_state = "idle"
	state = { name = "idle" state_time = 60 looping = no }
	state = { name = "stop" state_time = 0.5 looping = no }
}

# ---- 粒子宿主（已停用）：粒子改走独立环境物体。保留定义仅为回退，别 attach。----
entity = {
	name = "kaiju_gobble_particle_host_entity"
	scale = 0.1856

	default_state = "idle"
	state = { name = "idle" state_time = 60 looping = no
		start_event = { particle = "kaiju_gobble_planet_effect" keep_particle = yes }
	}
	state = { name = "stop" state_time = 0.5 looping = no }
}

# ---- 坐标轴标定件（临时）：红=X 绿=Y 蓝=Z。测完把 shards 里的 attach 注释掉。----
entity = {
	name = "kaiju_gobble_axis_entity"
	scale = 1

	default_state = "idle"
	state = { name = "idle" state_time = 900 looping = no
		start_event = { particle = "kaiju_gobble_axis_effect" keep_particle = yes }
	}
	state = { name = "stop" state_time = 0.5 looping = no }
}


# ---- 族 tundra ----

