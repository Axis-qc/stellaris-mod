# 碎片总实体（alpine）：attach 6 个碎片。不设朝向、不写 pdxmesh，
# 碎片动画沿模型 +Y 飞 = 世界竖直向上（导出时 Blender +Z -> 模型 +Y）：
# 分层起飞 -> 汇聚到高度 30 的一点 -> 再垂直升到 40，全程匀速缩小，到 40 缩到 0.002 消失。
# 覆盖：pc_alpine
entity = {
	name = "kaiju_gobble_shards_entity_alpine"
	locator = { name = "loc" position = { 0.0 0.0 0.0 } }
	scale = 1
	cull_radius = 800.0
	attach = { loc = "kaiju_gobble_shards_entity_alpine_a" }
	attach = { loc = "kaiju_gobble_shards_entity_alpine_b" }
	attach = { loc = "kaiju_gobble_shards_entity_alpine_c" }
	attach = { loc = "kaiju_gobble_shards_entity_alpine_d" }
	attach = { loc = "kaiju_gobble_shards_entity_alpine_e" }
	attach = { loc = "kaiju_gobble_shards_entity_alpine_f" }
}


