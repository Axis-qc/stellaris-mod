# 碎片总实体（tundra）：attach 6 个碎片。不设朝向、不写 pdxmesh，
# 碎片动画沿模型 +Y 飞 = 世界竖直向上（导出时 Blender +Z -> 模型 +Y）：
# 分层起飞 -> 汇聚到高度 30 的一点 -> 再垂直升到 40，全程匀速缩小，到 40 缩到 0.002 消失。
# 覆盖：pc_tundra / pc_nuked（nuked 地表原版就是 tundra_01，核爆感来自云层）
entity = {
	name = "kaiju_gobble_shards_entity_tundra"
	locator = { name = "loc" position = { 0.0 0.0 0.0 } }
	scale = 1
	cull_radius = 800.0
	attach = { loc = "kaiju_gobble_shards_entity_tundra_a" }
	attach = { loc = "kaiju_gobble_shards_entity_tundra_b" }
	attach = { loc = "kaiju_gobble_shards_entity_tundra_c" }
	attach = { loc = "kaiju_gobble_shards_entity_tundra_d" }
	attach = { loc = "kaiju_gobble_shards_entity_tundra_e" }
	attach = { loc = "kaiju_gobble_shards_entity_tundra_f" }
}


